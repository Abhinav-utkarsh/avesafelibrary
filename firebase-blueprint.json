        "seatMode": { "type": "string", "enum": ["fixed", "non_fixed", "unseated"] },
        "seatId": { "type": "string", "maxLength": 40 },
        "hall": { "type": "string", "enum": ["Hall 1", "Hall 2", "Unassigned"] },
        "shiftType": { "type": "string", "enum": ["morning", "noon", "evening", "night", "double", "triple", "all_shifts"] },
        "membershipExpiry": { "type": "string", "maxLength": 40 },
        "monthlyFee": { "type": "number" },
        "pendingAmount": { "type": "number" },
        "fingerprintTemplateId": { "type": "string", "maxLength": 64 },
        "gender": { "type": "string", "enum": ["male", "female", "other", "prefer_not_to_say"] },
        "profilePhotoUrl": { "type": "string", "maxLength": 140000 },
        "profilePhotoUpdatedAt": { "type": "string", "format": "date-time" },
        "cardNumber": { "type": "string", "maxLength": 40, "pattern": "^[A-Z0-9_\\-]*$" },
        "cardIssuedAt": { "type": "string", "format": "date-time" },
        "cardStatus": { "type": "string", "enum": ["none", "active", "revoked", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["registrationNo", "fullName", "phone", "admissionType", "status", "seatMode", "hall", "shiftType", "monthlyFee", "pendingAmount", "createdAt", "updatedAt"]
    },
    "Seat": {
      "title": "Seat",
      "description": "Physical study seat in Hall 1 (80 seats) or Hall 2 (40 seats).",
      "type": "object",
      "properties": {
        "seatCode": { "type": "string", "minLength": 2, "maxLength": 20, "pattern": "^[A-Z0-9_\\-]+$" },
        "hall": { "type": "string", "enum": ["Hall 1", "Hall 2"] },
        "seatNumber": { "type": "number" },
        "rowLabel": { "type": "string", "minLength": 1, "maxLength": 10 },
        "seatType": { "type": "string", "enum": ["fixed", "non_fixed"] },
        "status": { "type": "string", "enum": ["available", "occupied", "partial", "maintenance"] },
