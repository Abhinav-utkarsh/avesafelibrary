      "required": ["receiptNo", "studentId", "studentName", "billingMonth", "amountPaid", "discount", "dueAmount", "paymentMethod", "idempotencyKey", "collectedBy", "paidAt"]
    },
    "Expense": {
      "title": "Expense",
