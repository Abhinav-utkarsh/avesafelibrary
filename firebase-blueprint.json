        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "registrationNo": { "type": "string", "maxLength": 40 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 20 },
        "email": { "type": "string", "maxLength": 160 },
        "gender": { "type": "string", "enum": ["male", "female", "other", "prefer_not_to_say"] },
        "dateOfBirth": { "type": "string", "maxLength": 20 },
        "guardianName": { "type": "string", "maxLength": 120 },
        "guardianPhone": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 300 },
        "batchId": { "type": "string", "maxLength": 128 },
        "batchName": { "type": "string", "maxLength": 100 },
        "currentHall": { "type": "string", "enum": ["Hall 1", "Hall 2", "Unassigned"] },
        "currentSeatId": { "type": "string", "maxLength": 40 },
        "currentSeatMode": { "type": "string", "enum": ["fixed", "non_fixed", "unseated"] },
        "currentShiftType": { "type": "string", "enum": ["morning", "noon", "evening", "night", "double", "triple", "all_shifts"] },
        "requestedHall": { "type": "string", "enum": ["Hall 1", "Hall 2", "Unassigned"] },
        "requestedSeatId": { "type": "string", "maxLength": 40 },
        "requestedSeatMode": { "type": "string", "enum": ["fixed", "non_fixed", "unseated"] },
        "requestedShiftType": { "type": "string", "enum": ["morning", "noon", "evening", "night", "double", "triple", "all_shifts"] },
        "doublePresetId": { "type": "string", "maxLength": 40 },
        "estimatedMonthlyFee": { "type": "number" },
        "hasPortalPassword": { "type": "boolean" },
        "reason": { "type": "string", "maxLength": 500 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "reviewedByName": { "type": "string", "maxLength": 120 },
        "reviewNote": { "type": "string", "maxLength": 400 },
        "approvedStudentId": { "type": "string", "maxLength": 128 },
        "approvedRegistrationNo": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["referenceNo", "requestType", "status", "fullName", "phone", "requestedHall", "requestedSeatMode", "requestedShiftType", "estimatedMonthlyFee", "createdAt", "updatedAt"]
    }
