        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentName", "shiftType", "seatMode", "startDate", "endDate", "monthlyFee", "status", "createdAt", "updatedAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Immutable fee payment and receipt record.",
      "type": "object",
      "properties": {
        "receiptNo": { "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[A-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentUid": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "membershipId": { "type": "string", "maxLength": 128 },
        "billingMonth": { "type": "string", "minLength": 4, "maxLength": 20 },
