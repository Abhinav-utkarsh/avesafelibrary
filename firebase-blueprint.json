        "assignedStudentId": { "type": "string", "maxLength": 128 },
        "assignedStudentName": { "type": "string", "maxLength": 120 },
        "shiftSlots": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["seatCode", "hall", "seatNumber", "rowLabel", "seatType", "status", "updatedAt"]
    },
    "Membership": {
      "title": "Membership",
      "description": "Student shift subscription and seat allocation contract.",
