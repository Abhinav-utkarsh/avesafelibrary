    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized Av_eSAFE Library owner, manager, accounts officer, or desk staff member.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 160 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "role": { "type": "string", "enum": ["super_admin", "branch_manager", "manager", "accounts", "admin", "staff"] },
        "branch": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 20 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "role", "active", "createdAt", "updatedAt"]
    },
    "AdminInvite": {
      "title": "AdminInvite",
      "description": "Super Admin pre-approved Google Sign-In invitation for a staff or manager account.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 160 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "role": { "type": "string", "enum": ["super_admin", "branch_manager", "manager", "accounts", "admin", "staff"] },
        "branch": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 20 },
        "active": { "type": "boolean" },
        "invitedBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "claimedByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "fullName", "role", "active", "invitedBy", "createdAt", "updatedAt"]
    },
    "Batch": {
      "title": "Batch",
      "description": "Exam preparation or study cohort batch (e.g., UPSC, BPSC, Railway, Banking, SSC).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "code": { "type": "string", "minLength": 2, "maxLength": 30, "pattern": "^[A-Z0-9_\\-]+$" },
        "category": { "type": "string", "enum": ["upsc", "bpsc", "railway", "banking", "ssc", "state_psc", "defence", "teaching", "neet_jee", "ca_commerce", "law_judiciary", "it_tech", "college_school", "general", "other"] },
