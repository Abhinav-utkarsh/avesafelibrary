      "properties": {
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentUid": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "shiftType": { "type": "string", "enum": ["morning", "noon", "evening", "night", "double", "triple", "all_shifts"] },
        "seatMode": { "type": "string", "enum": ["fixed", "non_fixed"] },
        "seatId": { "type": "string", "maxLength": 40 },
        "startDate": { "type": "string", "minLength": 8, "maxLength": 40 },
        "endDate": { "type": "string", "minLength": 8, "maxLength": 40 },
        "monthlyFee": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "expiring_soon", "expired", "cancelled"] },
