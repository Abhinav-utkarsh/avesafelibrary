        "adminReply": { "type": "string", "maxLength": 1000 },
        "repliedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ticketNo", "studentId", "studentName", "category", "priority", "subject", "description", "status", "createdAt", "updatedAt"]
    },
    "StudentApprovalRequest": {
      "title": "StudentApprovalRequest",
      "description": "Student self-registration or existing student seat/shift/course change request pending administrator approval.",
      "type": "object",
      "properties": {
        "referenceNo": { "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[A-Z0-9_\\-]+$" },
