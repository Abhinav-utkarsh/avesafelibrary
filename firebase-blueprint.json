        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "code", "category", "active", "createdBy", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Enrolled Av_eSAFE Library student record with strict PII isolation.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "registrationNo": { "type": "string", "minLength": 3, "maxLength": 40, "pattern": "^[A-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 20 },
