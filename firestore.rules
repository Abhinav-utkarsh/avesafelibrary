        && isValidIoTDevice(incoming())
        && incoming().deviceCode == existing().deviceCode
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'location', 'mode', 'status', 'doorState', 'firmwareVersion', 'antiPassbackEnabled', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(deviceId) && isAdmin();
    }

    match /access_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidAccessLog(incoming())
        && incoming().timestamp == request.time
        && isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId) && (isAdmin() || settingId == 'library_config');
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(settingId)
        && isValidLibrarySettings(incoming())
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isSignedIn()
        && isValidId(settingId)
        && isValidLibrarySettings(incoming())
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'libraryName', 'location', 'hall1Capacity', 'hall2Capacity',
          'operatingHours', 'gracePeriodDays', 'antiPassbackMinutes', 'allowDemoAutoExpiry', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /id_cards/{cardNumber} {
      allow get: if isSignedIn() && isValidCardNumber(cardNumber) && isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidCardNumber(cardNumber)
        && isValidIdCard(incoming())
        && incoming().cardNumber == cardNumber
        && incoming().issuedBy == request.auth.uid
        && incoming().issuedAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin()
        && exists(/databases/$(database)/documents/students/$(incoming().studentId));
      allow update: if isSignedIn()
        && isValidCardNumber(cardNumber)
        && isValidIdCard(incoming())
        && incoming().cardNumber == existing().cardNumber
        && incoming().studentId == existing().studentId
        && incoming().issuedBy == existing().issuedBy
        && incoming().issuedAt == existing().issuedAt
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'studentName', 'membershipType', 'shiftType', 'hall', 'seatId',
          'validUntil', 'status', 'reprintCount', 'reprintHistory',
          'revokedReason', 'revokedAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Non-PII public single-document lookup for QR verification (list strictly forbidden)
    match /card_verifications/{cardNumber} {
      allow get: if isValidCardNumber(cardNumber);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidCardNumber(cardNumber)
        && isValidCardVerification(incoming())
        && incoming().cardNumber == cardNumber
        && incoming().issuedAt == request.time
        && incoming().updatedAt == request.time
