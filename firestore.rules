      allow update: if isSignedIn()
        && isValidId(templateId)
        && isValidMessageTemplate(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'category', 'title', 'body', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(templateId) && isAdmin();
    }

    match /student_tickets/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId) && (isAdmin() || existing().studentUid == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.studentUid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(ticketId)
        && isValidStudentTicket(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().status == 'open'
        && exists(/databases/$(database)/documents/students/$(incoming().studentId))
        && (
          isAdmin() ||
          (
            incoming().studentUid == request.auth.uid
            && get(/databases/$(database)/documents/students/$(incoming().studentId)).data.uid == request.auth.uid
          )
        );
      allow update: if isSignedIn()
        && isValidId(ticketId)
        && isValidStudentTicket(incoming())
        && incoming().ticketNo == existing().ticketNo
        && incoming().studentId == existing().studentId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'priority', 'adminReply', 'repliedBy', 'updatedAt'
          ])) ||
          (
            existing().studentUid == request.auth.uid
            && existing().status != 'closed'
            && incoming().status == 'closed'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(ticketId) && isAdmin();
    }

    match /student_approval_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        isAdmin() ||
        existing().studentUid == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid
      );
      allow create: if isSignedIn()
        && isValidId(requestId)
        && isValidStudentApprovalRequest(incoming())
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            incoming().requestType == 'seat_shift_change'
            && 'studentId' in incoming()
            && isValidId(incoming().studentId)
            && incoming().studentUid == request.auth.uid
            && exists(/databases/$(database)/documents/students/$(incoming().studentId))
            && get(/databases/$(database)/documents/students/$(incoming().studentId)).data.uid == request.auth.uid
          )
        );
      allow update: if isSignedIn()
        && isValidId(requestId)
        && isValidStudentApprovalRequest(incoming())
        && isAdmin()
        && incoming().referenceNo == existing().referenceNo
        && incoming().requestType == existing().requestType
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'studentId', 'registrationNo', 'requestedHall', 'requestedSeatId',
          'requestedSeatMode', 'requestedShiftType', 'doublePresetId', 'estimatedMonthlyFee',
          'reviewedBy', 'reviewedByName', 'reviewNote', 'approvedStudentId',
          'approvedRegistrationNo', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(requestId) && isAdmin();
    }
  }
}
