        && incoming().createdAt == request.time
        && isAdmin();
      allow update: if isSignedIn()
        && isValidId(expenseId)
        && isValidExpense(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().recordedBy == existing().recordedBy
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'amount', 'vendor', 'paymentMethod', 'expenseDate', 'notes']);
      allow delete: if isSignedIn() && isValidId(expenseId) && isAdmin();
    }

    match /attendance/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && (isAdmin() || existing().studentUid == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.studentUid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(recordId)
        && isValidAttendance(incoming())
        && incoming().updatedAt == request.time
        && isAdmin()
        && exists(/databases/$(database)/documents/students/$(incoming().studentId));
      allow update: if isSignedIn()
        && isValidId(recordId)
        && isValidAttendance(incoming())
        && incoming().studentId == existing().studentId
        && incoming().date == existing().date
        && incoming().entryTime == existing().entryTime
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['exitTime', 'durationMinutes', 'isInside', 'updatedAt']);
      allow delete: if false;
    }

    match /notices/{noticeId} {
      allow get: if isSignedIn() && isValidId(noticeId) && (isAdmin() || existing().published == true);
      allow list: if isSignedIn() && (isAdmin() || resource.data.published == true);
      allow create: if isSignedIn()
        && isValidId(noticeId)
        && isValidNotice(incoming())
        && incoming().publishedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isSignedIn()
        && isValidId(noticeId)
        && isValidNotice(incoming())
        && incoming().publishedBy == existing().publishedBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'category', 'priority', 'audience', 'published', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(noticeId) && isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (isAdmin() || existing().recipientUid == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.recipientUid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isSignedIn()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().recipientUid == existing().recipientUid
        && incoming().recipientRole == existing().recipientRole
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'type', 'read', 'updatedAt'])) ||
          (existing().recipientUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(notificationId) && isAdmin();
    }

    match /audit_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn()
