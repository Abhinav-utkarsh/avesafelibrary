        && isValidCardVerification(incoming())
        && incoming().cardNumber == existing().cardNumber
        && incoming().issuedAt == existing().issuedAt
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'registrationNo', 'studentName', 'membershipType', 'shiftLabel',
          'hall', 'seatId', 'membershipExpiry', 'studentStatus', 'cardStatus', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /online_payment_verifications/{verificationId} {
      allow get: if isSignedIn() && isValidId(verificationId) && (isAdmin() || existing().studentUid == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.studentUid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(verificationId)
        && isValidOnlinePaymentVerification(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().status == 'pending'
        && exists(/databases/$(database)/documents/students/$(incoming().studentId))
        && (
          (isAdmin() && incoming().submittedByRole == 'admin') ||
          (
            incoming().studentUid == request.auth.uid
            && incoming().submittedByRole == 'student'
            && get(/databases/$(database)/documents/students/$(incoming().studentId)).data.uid == request.auth.uid
          )
        );
      allow update: if isSignedIn()
        && isValidId(verificationId)
        && isValidOnlinePaymentVerification(incoming())
        && isAdmin()
        && incoming().studentId == existing().studentId
        && incoming().utrReference == existing().utrReference
        && incoming().amount == existing().amount
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'receiptNo', 'reviewedBy', 'reviewNote', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(verificationId) && isAdmin();
    }

    match /message_templates/{templateId} {
      allow get: if isSignedIn() && isValidId(templateId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(templateId)
        && isValidMessageTemplate(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
