# Server Configuration
PORT=3000
NODE_ENV=development

# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"

# Bootstrap Super Admin Email (must verify email via Firebase Auth)
ADMIN_BOOTSTRAP_EMAIL="abhinavutkarsh3@gmail.com"

# Comma-separated allowed CORS origins (optional; defaults to same-origin)
ALLOWED_ORIGINS=""

# Session signing secret for Student & Admin Password Portal tokens (set a 32+ char random string on Vercel)
STUDENT_SESSION_SECRET=""

# Smart Door IoT HMAC-SHA256 Master Key (server-side only, Phase 8)
# Leave empty until physical ESP32 hardware is provisioned.
IOT_HMAC_SECRET_KEY=""
